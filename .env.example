# Dynamic Pricing Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.
#
# These values are for YOUR tools (the pricing tool and its helpers).
# Claude Code does not read `.env` by itself. The agent and skill files
# use placeholders with the same names; see "Customising" in the README.

# ============================================================
# Hotel identity
# ============================================================

HOTEL_NAME="Your Hotel Name"
PMS_PROPERTY_ID="your-pms-property-id"

# Add the API credentials that your PMS needs here, under the
# variable names that your own tools read.

# ============================================================
# Tool paths (same values as the placeholders in the agent files)
# ============================================================

PRICING_TOOL="tools/dynamic_pricing.py"
PMS_RATES_TOOL="tools/pms_rates.py"
PMS_AVAILABILITY_TOOL="tools/sync_availability.py"

# ============================================================
# Floor prices per room type (in your PMS currency)
# ============================================================
# Tier A = 0–3 days out, Tier B = 4–6 days out. Tier A is the lower one.
# EXAMPLE numbers: replace with your own floors, one pair for each
# room type. Your pricing tool must read these and must not propose
# a rate below them.

FLOOR_PRICE_PREMIUM_TIER_A="290"
FLOOR_PRICE_PREMIUM_TIER_B="330"
FLOOR_PRICE_STANDARD_TIER_A="160"
FLOOR_PRICE_STANDARD_TIER_B="170"
