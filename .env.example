# Dynamic Pricing Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.

# ============================================================
# Hotel identity
# ============================================================

HOTEL_NAME="Your Hotel Name"

# ============================================================
# PMS (Property Management System) integration
# ============================================================
# The agent uses these tools to read current rates and to push
# rate / MLOS changes.

PMS_PROPERTY_ID="{{PMS_PROPERTY_ID}}"
PMS_RATES_TOOL="tools/pms_rates.py"
PRICING_TOOL="tools/dynamic_pricing.py"
PMS_AVAILABILITY_TOOL="tools/sync_availability.py"

# ============================================================
# Floor prices per room type (€)
# ============================================================
# Tier A = 0–3 days out, Tier B = 4–6 days out.
# These are EXAMPLE placeholders — replace with your own per-room
# floors. The pricing tool reads them and never proposes anything
# below these values.

FLOOR_PRICE_PREMIUM_TIER_A="290"
FLOOR_PRICE_PREMIUM_TIER_B="330"
FLOOR_PRICE_STANDARD_TIER_A="170"
FLOOR_PRICE_STANDARD_TIER_B="160"

# ============================================================
# Optional — log every push to a sheet for audit
# ============================================================

# SHEET_ID_PRICING=""
