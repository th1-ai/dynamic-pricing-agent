{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash({{PRICING_TOOL}} --format json *)",
      "Bash({{PMS_RATES_TOOL}} *)",
      "Bash(date *)",
      "Edit(./runs/**)",
      "Edit(./.claude/agent-memory/dynamic-pricing/**)"
    ],
    "deny": [
      "Bash(*--push*)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./AUTONOMY.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/autonomy-guard.py",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
